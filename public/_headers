# Caching rules for Cloudflare Pages (GitHub Pages ignores this file).
#
# Built scripts and styles have a content hash in their names, so a changed
# file is a new URL: they can be kept for a year without ever going stale.
# Pages themselves keep Cloudflare's default (always revalidated), so an
# update shows on the next visit.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/silo/assets/*
  Cache-Control: public, max-age=31536000, immutable

/price-pulse/assets/*
  Cache-Control: public, max-age=31536000, immutable

/work-signal/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed media: the music, cassettes, the environment map. A week, then the
# browser checks for a newer copy in the background.
/silo/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/silo/env/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/silo/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
