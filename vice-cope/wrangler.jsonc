// The old address of Vice Cope (vice-cope.<account>.workers.dev): now only a
// redirect to https://vice-cope.pages.dev, so links shared early keep working.
//
//   npx wrangler deploy --config vice-cope/wrangler.jsonc
//
// The page itself is deployed with: node scripts/deploy-vice-cope.mjs
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vice-cope",
  "main": "redirect.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true
}
