{
  "name": "DorAI — best price on Daraz and Cartup",
  "short_name": "DorAI",
  "description": "Name a product, or share one from the Daraz or Cartup app, and see its best price on both stores.",
  "id": "/price-pulse/",
  "start_url": "/price-pulse/",
  "scope": "/price-pulse/",
  "display": "standalone",
  "background_color": "#101317",
  "theme_color": "#101317",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/price-pulse/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
