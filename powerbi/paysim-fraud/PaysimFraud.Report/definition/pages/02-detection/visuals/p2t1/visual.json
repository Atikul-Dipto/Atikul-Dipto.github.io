              {
                "textRuns": [
                  {
                    "value": "The feature",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "fontWeight": "bold",
                      "color": "#1B2430"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A fraudulent transfer moves an amount exactly equal to the origin account's opening balance, to the cent. The account is emptied in one move.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#2B3440"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It holds on 8,034 of 8,213 fraud legs and 1 of 6,354,407 legitimate ones -- a 63.99 payment to a merchant that left 0.01 behind, which the rule excludes by only counting money out to a customer account.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#2B3440"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "In-sample: the rule was derived from the labels it is scored against. On real data it would need a held-out period before anyone relied on it.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#5A6572"
                    }
                  }
                ]
              }
            ]
          }
        }
